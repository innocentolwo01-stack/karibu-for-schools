{
  "expo": {
    "name": "Karibu For Schools",
    "slug": "karibu-for-schools",
    "scheme": "karibuforschools",
    "version": "0.4.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 210,
          "resizeMode": "contain",
          "backgroundColor": "#111111",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#111111"
          }
        }
      ]
    ],
    "android": {
      "package": "global.karibu.forschools",
      "versionCode": 4,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#111111"
      },
      "edgeToEdgeEnabled": true
    },
    "ios": {
      "bundleIdentifier": "global.karibu.forschools",
      "supportsTablet": true
    }
  }
}
